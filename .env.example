# Copy to .env and fill in. Never commit .env.

# Chain (Ethereum Sepolia)
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_KEY=            # funded with Sepolia ETH; owns waterline.eth and administers Marks
REPORTER_KEY=            # the Waterline API's account; the only one allowed to record reports (needs a little Sepolia ETH)
REPORTER_ADDRESS=        # address of REPORTER_KEY
NAME_SECRET=             # any 0x + 64 hex chars, used for the ENS commit/register
MARKS_ADDRESS=           # filled after deploy (contracts/deployments/sepolia.json)

# Waterline API
REDIS_URL=               # Upstash via `vercel integration add`; unset = in-memory (local only)
VOTER_SECRET=            # random 32+ bytes
AGENT_TOKEN_SECRET=      # random 32+ bytes

# World ID (Human Continuity, sandbox)
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=

# Curvegrid MultiBaas (Ethereum Sepolia deployment)
MB_URL=                  # https://<id>.multibaas.com
MB_API_KEY=              # admin key: scripts/API only
MB_DAPP_KEY=             # DApp User key: the only key allowed in the web page

# Jev (TypeSafe), optional
TYPESAFE_API_KEY=
