# Copy to .env and fill in. Never commit .env. Read by scripts/*.{sh,py} (the shell's own env wins).
# Quote values with spaces or JSON in single quotes. On Vercel, set the API's vars with `vercel env add NAME production`.

# Chain (Ethereum Sepolia)
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com   # server-side RPC; may carry a key, never shown to browsers
PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com   # keyless RPC the browser uses for ENS reads
DEPLOYER_KEY=            # funded with Sepolia ETH; owns waterline.eth and administers Marks (scripts only, never on Vercel)
REPORTER_KEY=            # the Waterline API's account; the only one allowed to record reports (needs a little Sepolia ETH)
REPORTER_ADDRESS=        # address of REPORTER_KEY
NAME_SECRET=             # any 0x + 64 hex chars, used for the ENS commit/register
NAME_LABEL=              # optional; default waterline (the API names GPUs under waterline.eth, so leave it unset)
MARKS_ADDRESS=           # printed by scripts/deploy_marks.sh (contracts/deployments/sepolia.json)
ENS_UNIVERSAL_RESOLVER=0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe   # contracts/ens.sepolia.json; set on Vercel (contracts/ isn't bundled)

# Waterline API
API_URL=                 # the deployed API, e.g. https://<project>.vercel.app (webhook target, preflight, agent)
REDIS_URL=               # Upstash via `vercel integration add`; unset = in-memory (local only)
ALLOW_CLIENT_SIZES=      # 1 = let the prover choose n/steps (tests, local CPU demo). Never set in production.
CHECK_STEPS=             # steps per check when the prover sends none (default 100); from python3 -m prover.calibrate
DEADLINES=               # optional JSON, seconds per class code or model id, e.g. '{"1": 7.4, "h100-sxm": 7.4}'; unset = formula

# Curvegrid MultiBaas (Ethereum Sepolia deployment)
MB_URL=                  # https://<id>.multibaas.com
MB_API_KEY=              # admin key: API + scripts only, never in the browser
MB_MARKS_ALIAS=marks     # address alias of Marks (scripts/multibaas_link.py creates it)
MB_MARKS_LABEL=marks     # contract label of Marks
MB_WEBHOOK_SECRET=       # printed once by scripts/multibaas_link.py

# Agent (renter's laptop)
WATERLINE_API=           # same as API_URL; default http://localhost:3000
WATERLINE_STOP_CMD=      # run on FAIL to stop paying, e.g. 'runpodctl stop pod {pod_id}'
TYPESAFE_API_KEY=        # Jev (TypeSafe), optional: reads listing text only
